# ===========================================
# Shabari Backend Environment Variables
# ===========================================

# Node Environment
NODE_ENV=development

# Database Configuration (MySQL/MariaDB)
DATABASE_URL=mysql://user:password@localhost:3306/shabari

# Redis Configuration
REDIS_URL=redis://localhost:6379

# ===========================================
# VPA Verification APIs (Step 1.2)
# Choose one or both for fallback support
# ===========================================

# Cashfree API (Primary)
# Get keys from: https://merchant.cashfree.com/
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Razorpay API (Fallback)
# Get keys from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===========================================
# Link & Malware Scanner APIs (Step 1.3)
# ===========================================

# Google Safe Browsing API
# Get key from: https://console.cloud.google.com/apis/credentials
GOOGLE_SAFE_BROWSING_API_KEY=AIzaSyCXDe2bQoBdAHZYQren9NBWuRvjeONzRQE

# VirusTotal API
# Get key from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=79df999765cde7b193b1cfd28d179add44b8a10ee9216299cefcbfe994c76ad0

# ===========================================
# Optional: Owner Configuration
# ===========================================

# Owner's OpenID for admin access
OWNER_OPEN_ID=

# ===========================================
# Expo Public Variables (Frontend)
# ===========================================

# Backend API URL for mobile app
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
